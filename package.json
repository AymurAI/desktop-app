{
  "name": "aymurai",
  "version": "1.5.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev:web": "cross-env VITE_APP_MODE=web vite --config vite.config.ts",
    "dev": "cross-env VITE_APP_MODE=electron electron-vite dev",
    "start": "cross-env VITE_APP_MODE=electron electron-vite preview",
    "start:web": "cross-env VITE_APP_MODE=web vite preview --config vite.config.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "validate": "pnpm lint && pnpm typecheck",
    "pre-commit": "lint-staged",
    "package": "rm -rf build && pnpm run build && electron-forge package",
    "make": "rm -rf build && pnpm run build && electron-forge make",
    "postinstall": "electron-builder install-app-deps || true",
    "panda:codegen": "panda codegen",
    "prepare": "panda codegen",
    "build:web": "cross-env VITE_APP_MODE=web vite build --config vite.config.ts",
    "build": "pnpm run typecheck && cross-env VITE_APP_MODE=electron electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "cross-env VITE_APP_MODE=electron electron-vite build && electron-builder --mac",
    "build:linux": "cross-env VITE_APP_MODE=electron electron-vite build && electron-builder --linux",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aymurai/ui": "github:AymurAI/ui-components#v0.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "fastest-levenshtein": "^1.0.16",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron-forge/cli": "^6.4.2",
    "@electron-forge/maker-deb": "^6.4.2",
    "@electron-forge/maker-rpm": "^6.4.2",
    "@electron-forge/maker-squirrel": "^6.4.2",
    "@electron-forge/maker-zip": "^6.4.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@pandacss/dev": "^1.11.3",
    "@pandacss/preset-panda": "^1.11.4",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-select": "^2.3.0",
    "@stitches/react": "^1.2.8",
    "@tanstack/react-form": "1.11.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.42",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/regex-escape": "^3.4.1",
    "@vitejs/plugin-react": "^4.7.0",
    "axios": "^1.17.0",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.0.12",
    "electron-debug": "^3.2.0",
    "electron-devtools-installer": "^3.2.1",
    "electron-vite": "^5.0.0",
    "exceljs": "^4.4.0",
    "husky": "^8.0.3",
    "i18next": "^25.10.10",
    "jsdom": "^25.0.1",
    "knip": "^6.16.1",
    "lefthook": "^2.1.6",
    "lint-staged": "^13.3.0",
    "markdownlint-cli": "^0.32.2",
    "nodemon": "^2.0.22",
    "phosphor-react": "^1.4.1",
    "prettier": "^2.8.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.6.6",
    "regex-escape": "^3.4.11",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "wait-on": "^6.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
